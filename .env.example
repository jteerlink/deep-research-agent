
# Deep Research Agent foundation configuration
# Copy to .env for local use. Do not commit real secrets.

# Primary model provider. Supported: ollama_native, ollama_openai_compatible, openai, codex_openai_compatible.
DEEP_RESEARCH_MODEL_PROVIDER=ollama_native
DEEP_RESEARCH_FALLBACK_ORDER=codex_openai_compatible,openai

# Native Ollama API (not OpenAI-compatible). Use local Ollama by default; set to https://ollama.com/api for Ollama Cloud native mode.
OLLAMA_NATIVE_BASE_URL=http://localhost:11434
OLLAMA_NATIVE_MODEL=deepseek-v4-pro:cloud
OLLAMA_API_KEY=

# Ollama OpenAI-compatible API surface. Do not infer this from Native Ollama API settings.
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
OLLAMA_OPENAI_MODEL=deepseek-v4-pro:cloud
OLLAMA_OPENAI_API_KEY=ollama

# OpenAI fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Codex/OpenAI-compatible fallback.
CODEX_OPENAI_BASE_URL=
CODEX_OPENAI_API_KEY=
CODEX_OPENAI_MODEL=

# Optional web search provider keys used by async_multi_search.py.
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
YDC_API_KEY=

# Optional TLS CA bundle override for corporate proxies or custom roots.
# On macOS, async_multi_search.py auto-generates a local bundle from the
# system keychain when this is unset. Set this only when you need a specific
# PEM bundle.
DEEP_RESEARCH_CA_BUNDLE=
DEEP_RESEARCH_DISABLE_MACOS_KEYCHAIN_CA=false

# LangGraph local runtime knobs.
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=2024

# Runtime knobs.
DEEP_RESEARCH_MAX_SEARCH_RESULTS=5
DEEP_RESEARCH_SEARCH_TIMEOUT_SECONDS=10
DEEP_RESEARCH_MODEL_RETRY_ATTEMPTS=1

# Backward-compatible aliases from early G001 scaffold; prefer DEEP_RESEARCH_* names above.
DRA_PRIMARY_PROVIDER=ollama_native
DRA_OLLAMA_BASE_URL=https://ollama.com/api
DRA_OLLAMA_MODEL=deepseek-v4-pro:cloud
DRA_OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
DRA_OLLAMA_OPENAI_MODEL=deepseek-v4-pro:cloud
DRA_OLLAMA_OPENAI_API_KEY=ollama
DRA_MAX_SEARCH_RESULTS=5
DRA_SEARCH_TIMEOUT_SECONDS=10
