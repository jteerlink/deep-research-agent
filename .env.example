# deep-research-agent local configuration example
# Copy to .env for local development. Real secrets stay out of git.

# -----------------------------------------------------------------------------
# Model provider selection
# -----------------------------------------------------------------------------
# Choose one: ollama_native, ollama_openai, openai, codex
DEEP_RESEARCH_MODEL_PROVIDER=ollama_native

# Native Ollama API (http://localhost:11434/api/chat). This is distinct from
# Ollama's OpenAI-compatible /v1 API and is useful when calling Ollama directly.
OLLAMA_NATIVE_BASE_URL=http://localhost:11434
OLLAMA_NATIVE_MODEL=llama3.1:8b

# Ollama OpenAI-compatible API (http://localhost:11434/v1). Use this path when
# a client expects OpenAI Chat Completions semantics against a local Ollama host.
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
OLLAMA_OPENAI_MODEL=llama3.1:8b
OLLAMA_OPENAI_API_KEY=ollama

# Hosted OpenAI fallback. Leave blank for local-only Ollama development.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Codex/OpenAI-compatible fallback for agent runtime experiments. Keep this
# separate from the hosted OpenAI fallback so local and Codex paths are explicit.
CODEX_OPENAI_BASE_URL=
CODEX_OPENAI_API_KEY=
CODEX_OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Search provider keys used by async_multi_search.py. Configure any subset.
# DuckDuckGo is the keyless fallback when ddgs/duckduckgo_search is installed.
# -----------------------------------------------------------------------------
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# -----------------------------------------------------------------------------
# LangGraph development server
# -----------------------------------------------------------------------------
# Keep LangGraph config local-first. The graph path is declared in langgraph.json.
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=2024
