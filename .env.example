# Deep Research Agent foundation configuration
# Copy to .env for local use. Do not commit real secrets.

# Primary model provider: ollama_native, ollama_openai, openai, or codex.
DRA_PRIMARY_PROVIDER=ollama_native

# Ollama native API (not OpenAI-compatible).
DRA_OLLAMA_BASE_URL=http://localhost:11434
DRA_OLLAMA_MODEL=llama3.1

# Ollama OpenAI-compatible API surface.
DRA_OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
DRA_OLLAMA_OPENAI_MODEL=llama3.1
DRA_OLLAMA_OPENAI_API_KEY=ollama

# OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Codex/OpenAI-compatible fallback for environments that expose Codex keys.
CODEX_API_KEY=
CODEX_MODEL=gpt-5.4-mini
CODEX_BASE_URL=https://api.openai.com/v1

# Optional web search provider keys used by async_multi_search.py.
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# Runtime knobs.
DRA_MAX_SEARCH_RESULTS=5
DRA_SEARCH_TIMEOUT_SECONDS=10
